module detector ( input clk, reset, din , output reg detect);

//states:
parameter S0 = 3'b0;
parameter S1 = 3'b1;
parameter S2 = 3'b10;
parameter S3 = 3'b101;

reg current_state,next_state;

//current state:
always @( posedge clk) begin
  if ( reset )
  current_state <= S0;
  else
  current_state <= next_state;
end

//next state
always @(*) begin
  case (current_state)
  S0:begin
    if ( din == 1)
    next_state = S1;
    else 
    next_state = S0;
    end
  S1:begin
    if ( din == 1)
    next_state = S1;
    else 
    next_state = S2;
    end
  S2:begin
    if ( din == 1)
    next_state = S3;
    else 
    next_state = S0;
    end

  //output logic
    always @(*) begin
    if ( current_state == S3 && din == 1)
    detect = 1'b1;
    else 
    detect = 1'b0;
    end
    endmodule
